        <material name="tag_mat_5" texture="tag_tex_5" texrepeat="1 1" texuniform="false" specular="0" shininess="0"/> 
        
        <!-- Added AprilTag 07 for World Origin -->
        <texture name="tag_tex_7" type="2d" file="tag36h11_07.png"/> 
        <material name="tag_mat_7" texture="tag_tex_7" texrepeat="1 1" texuniform="false" specular="0" shininess="0"/> 
    </asset> 
    <worldbody> 
        <light pos="0.094 -0.036 3.473" dir="0 0 -1" directional="true" /> 
        <geom name="floor" size="0 0 0.05" pos="0.094 -0.036 -0.165" type="plane" material="groundplane" /> 
        <!--
          WORLD ORIGIN MARKER: static body, no joint, nothing attached to it.
          Nothing in this file can move it. Red = x, green = y, blue = z, 3 cm long.
          Cube and hand edits never touch it.
        -->
        <body name="world_origin" pos="0 0 0">
            <geom type="capsule" fromto="0 0 0 0.03 0 0" size="0.0008" rgba="1 0 0 1" contype="0" conaffinity="0" group="1"/>
            <geom type="capsule" fromto="0 0 0 0 0.03 0" size="0.0008" rgba="0 1 0 1" contype="0" conaffinity="0" group="1"/>
            <geom type="capsule" fromto="0 0 0 0 0 0.03" size="0.0008" rgba="0 0 1 1" contype="0" conaffinity="0" group="1"/>
            
            <!-- Added 2cm flat box for AprilTag 07 -->
            <geom name="tag_number_7" type="box" pos="0 0 0" size="0.01 0.01 0.0001" material="tag_mat_7" rgba="1 1 1 1" contype="0" conaffinity="0"/>
        </body>

        <!--
          CUBE: ONE knob = the pos below (position of the cube's own frame, world coordinates).
          It has to match the LAST 7 numbers of the keyframe at the bottom (x y z 1 0 0 0),
          because a keyframe reset overwrites this pos. Change both together.
          Old keyframe placement was  -0.0844 0.033 0  (paste it in both places if you want it).
        -->
        <body name="cube" pos="-0.112 0.038 0"> 
    <freejoint name="cube_joint"/> 
    <inertial pos="-0.0028 -0.035 0.0011" mass="0.041" diaginertia="1.5378e-05 1.5378e-05 1.5378e-05"/> 
    
    <!-- Primary STL mesh scaled to 6cm -->
    <geom name="cube" type="mesh" mesh="cube_mesh" size="0.03 0.03 0.03" contype="5" conaffinity="5" friction="0.5 0.005 0.0001" rgba="1 0.999 0.89 1"/> 
    
    <!-- Top (+Z) Face -> Tag 5 -->
    <geom name="tag_number_5" type="box" pos="-0.024 -0.042 0.0301" size="0.006 0.006 0.0001" material="tag_mat_5" rgba="1 1 1 1" contype="0" conaffinity="0"/> 

    <!-- Bottom (-Z) Face -> Tag 0 -->
    <geom name="tag_number_0" type="box" pos="-0.024 -0.042 -0.0301" size="0.006 0.006 0.0001" material="tag_mat_0" rgba="1 1 1 1" contype="0" conaffinity="0"/> 

