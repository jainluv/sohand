    <geom name="tag_number_1" type="box" pos="0.0301 -0.066 0.0" size="0.006 0.006 0.0001" quat="0.7071068 0 0.7071068 0" material="tag_mat_1" rgba="1 1 1 1" contype="0" conaffinity="0"/> 

