    <!-- Front (+Y) Face -> Tag 4 (X=0.0 ensures strict +Y normal dominance) -->
    <geom name="tag_number_4" type="box" pos="0.0 -0.0119 0.0" size="0.006 0.006 0.0001" quat="0.7071068 -0.7071068 0 0" material="tag_mat_4" rgba="1 1 1 1" contype="0" conaffinity="0"/> 

    <!-- Back (-Y) Face -> Tag 2 -->
    <geom name="tag_number_2" type="box" pos="-0.024 -0.0721 0.0" size="0.006 0.006 0.0001" quat="0.7071068 0.7071068 0 0" material="tag_mat_2" rgba="1 1 1 1" contype="0" conaffinity="0"/> 
</body>
